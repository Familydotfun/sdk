{
  "name": "@familydotfun/sdk",
  "version": "0.1.0",
  "description": "Family Product SDK — build modules and apps that run inside Family.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "module": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "PROTOCOL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pack:vendor": "npm run build && npm pack --pack-destination ../../launchapp/vendor"
  },
  "keywords": [
    "family",
    "familydotfun",
    "sdk",
    "web3"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
